{
  // V2 terminal-client config: ONE global file (~/.config/opencode/cli.json),
  // owned by the TUI (the server never loads it). The installer merges this
  // template with the user's existing cli.json (leaf-granularity defaults
  // fill) and migrates a legacy v1 tui.jsonc on upgrade.
  // Plugin entries MUST be DIRECTORIES, never bare files: the v2 TUI
  // reconcile silently skips file entries (stat().isFile() → continue, no
  // toast/log). Each directory's entrypoint is its `tui.ts`.
  // `removed_plugins`: installer-only retirement list (mirrors
  // opencode.template.jsonc's removed_agents) — package keys dropped from
  // `plugins` below get stripped from the user's cli.json on next install;
  // without it a deleted plugin's entry survives forever while the
  // stale-file prune already removed its files. Stripped from the output.
  "removed_plugins": [],
  "$schema": "https://opencode.ai/v2/cli.json",
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "image_preview": true,
    "tps": true
  },
  "tabs": {
    "layout": "vertical"
  },
  "plugins": [
    "./plugins/tui/provider-wizard",
    "./plugins/tui/profile-wizard",
    "./plugins/tui/project-wizard",
    "./plugins/tui/sidebar-status",
    "./plugins/tui/usage"
  ]
}
