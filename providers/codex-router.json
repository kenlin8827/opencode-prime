{
  "codex-router": {
    "npm": "@ai-sdk/openai-compatible",
    "name": "codex-router",
    "options": {
      "baseURL": "{env:CODEX_ROUTER_BASE_URL}",
      "apiKey": "{env:CODEX_ROUTER_API_KEY}"
    },
    "models": {
      "gpt-5.6-sol":          { "name": "GPT 5.6 Sol",          "id": "cx/gpt-5.6-sol",          "attachment": true, "reasoning": true, "modalities": { "input": ["text", "image"], "output": ["text"] } },
      "gpt-5.6-terra":        { "name": "GPT 5.6 Terra",        "id": "cx/gpt-5.6-terra",        "attachment": true, "reasoning": true, "modalities": { "input": ["text", "image"], "output": ["text"] } },
      "gpt-5.6-luna":         { "name": "GPT 5.6 Luna",         "id": "cx/gpt-5.6-luna",         "attachment": true, "reasoning": true, "modalities": { "input": ["text", "image"], "output": ["text"] } }
    }
  }
}
