      ]
    },
    "code-review": {
      "description": "Code reviewer — reviews git diffs, PRs, staged/unstaged changes, specific files. Invoke for code review, PR review, or feedback on code quality, correctness, security, or best practices.",
      "system": "{file:~/.config/opencode/prompts/code-review.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "steps": 30,
      // Review context needs git archaeology (log/blame/show/diff) and CVE/doc
      // lookups — allow those; deny every other shell command.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git blame*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git grep*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git show*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "codegraph-scout": {
      "description": "CodeGraph Scout — produces compact, source-free relationship evidence for an L3 code review. Dispatch only for a cross-module, public-contract, or otherwise unclear graph-impact question; never as a general code reader or reviewer.",
      "system": "{file:~/.config/opencode/prompts/codegraph-scout.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.1 } },
      "steps": 6,
      // CodeGraph returns source with every answer. This leaf agent is the
      // compression boundary: it may call only CodeGraph and forwards a
      // bounded relationship map, never retrieved source, to the reviewer.
      // The native read/glob/grep/shell surface is denied outright (v1 tools
      // map); the one-backend rule is {action:"codegraph_*"} deny then the
      // exact-tool allow (last match wins).
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_codegraph_explore", "resource": "*", "effect": "allow" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "tgrep_search", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "gitnexus-scout": {
      "description": "GitNexus Scout — produces compact, source-free process or cross-repository relationship evidence for an L3 code review. Dispatch only when GitNexus is indexed and a process, group, or cross-repository question needs its unique capability; never as a general code reader or reviewer.",
      "system": "{file:~/.config/opencode/prompts/gitnexus-scout.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.1 } },
      "steps": 6,
      // The query tool returns relationship metadata without source by default.
      // Keep the expensive GitNexus surface to one focused query and forward
      // only the bounded evidence map to the deep reviewer.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "deny" },
        { "action": "glob", "resource": "*", "effect": "deny" },
        { "action": "grep", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_query", "resource": "*", "effect": "allow" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "tgrep_search", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "code-review-fast": {
      "description": "Fast code reviewer — triages ordinary diffs for P0/P1 correctness and security issues. Use for the default review pass; escalate sensitive paths or uncertain critical findings to code-review.",
      "system": "{file:~/.config/opencode/prompts/code-review.md}\n\n{file:~/.config/opencode/prompts/code-review-fast.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "steps": 15,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git blame*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git grep*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git log*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git show*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff*", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "devops": {
      "description": "DevOps/SRE engineer — Docker, Kubernetes, CI/CD, Terraform, monitoring, deployment. Invoke for Docker, K8s, deploy, CI/CD, pipeline, Terraform, or infrastructure.",
      "system": "{file:~/.config/opencode/prompts/devops.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      // serena stays for IaC/app code context; hide GitNexus (Scout-only),
      // dbhub (@dba), idea, Headroom.
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "tech-writer": {
      "description": "Technical writer — README, API docs, architecture docs, ADRs, changelogs, user guides. Invoke for documentation, README, changelog, ADR, or developer guide tasks.",
      "system": "{file:~/.config/opencode/prompts/tech-writer.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      // Docs work reads rendered text, not symbol graphs — hide the MCP
      // tool surface (including the optional graph/DB/IDE servers if enabled).
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "vision": {
      "description": "Visual / vision analyst — screenshot analysis, UI critique, OCR, diagram interpretation. Invoke for image, screenshot, OCR, or visual analysis tasks.",
      "system": "{file:~/.config/opencode/prompts/vision.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      "steps": 30,
      // Image analysis has no use for code graphs or DB/IDE bridges —
      // hide the MCP tool surface.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "fast-coder": {
      "description": "Flash Coder — agile, high-throughput full-stack coding subagent powered by Flash/Lite model tiers. Dispatched for rapid coding and iterative review loops.",
      "system": "{file:~/.config/opencode/prompts/fast-coder.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      // Coding leaf — align with the six language devs: serena + codegraph
      // stay (schema/impact while coding); hide GitNexus (Scout-only),
      // dbhub (@dba), idea, Headroom.
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
