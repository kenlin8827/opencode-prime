    "fast-coder": {
      "description": "Flash Coder — agile, high-throughput full-stack coding subagent powered by Flash/Lite model tiers. Dispatched for rapid coding and iterative review loops.",
      "prompt": "{file:~/.config/opencode/prompts/fast-coder.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "temperature": 0.2,
      // medium (not low): fast-coder produces production-grade code (zero mocks,
      // zero unhandled errors per its prompt) — /dev-quick ships with ZERO review,
      // so low variant on a flash-tier model would silently degrade code quality.
      // explore keeps low (retrieval, not reasoning); fast-coder needs reasoning.
      "variant": "medium",
      "permission": {
        "skill": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" }
      },
      "tools": { "task": false }
