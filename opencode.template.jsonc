    "code-review": {
      "description": "Code reviewer — reviews git diffs, PRs, staged/unstaged changes, specific files. Invoke for code review, PR review, or feedback on code quality, correctness, security, or best practices.",
      "prompt": "{file:~/.config/opencode/prompts/code-review.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "temperature": 0.3,
      "steps": 30,
      "variant": "high",
      // Review context needs git archaeology (log/blame/show/diff) and CVE/doc
      // lookups — allow those; deny every other bash command.
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git blame*": "allow",
          "git status*": "allow",
          "git grep*": "allow",
          "rtk git log*": "allow",
          "rtk git show*": "allow",
          "rtk git diff*": "allow",
          "rtk git status*": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow",
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "headroom_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "codegraph-scout": {
      "description": "CodeGraph Scout — produces compact, source-free relationship evidence for an L3 code review. Dispatch only for a cross-module, public-contract, or otherwise unclear graph-impact question; never as a general code reader or reviewer.",
      "prompt": "{file:~/.config/opencode/prompts/codegraph-scout.md}",
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 6,
      "variant": "medium",
      // CodeGraph returns source with every answer. This leaf agent is the
      // compression boundary: it may call only CodeGraph and forwards a
      // bounded relationship map, never retrieved source, to the reviewer.
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "codegraph_codegraph_explore": { "*": "allow" },
        "headroom_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      },
      "tools": {
        "task": false,
        "bash": false,
        "read": false,
        "glob": false,
        "grep": false,
        "edit": false,
        "write": false,
        "webfetch": false,
        "websearch": false
      }
    },
    "gitnexus-scout": {
      "description": "GitNexus Scout — produces compact, source-free process or cross-repository relationship evidence for an L3 code review. Dispatch only when GitNexus is indexed and a process, group, or cross-repository question needs its unique capability; never as a general code reader or reviewer.",
      "prompt": "{file:~/.config/opencode/prompts/gitnexus-scout.md}",
      "mode": "subagent",
      "temperature": 0.1,
      "steps": 6,
      "variant": "medium",
      // The query tool returns relationship metadata without source by default.
      // Keep the expensive GitNexus surface to one focused query and forward
      // only the bounded evidence map to the deep reviewer.
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "headroom_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "gitnexus_query": { "*": "allow" },
        "dbhub_*": { "*": "deny" },
