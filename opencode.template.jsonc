{
  "removed_agents": ["coworker", "explorer"],
  "$schema": "https://opencode.ai/config.json",
  "snapshots": true,
  "default_agent": "lite",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "instructions": [
    "~/.config/opencode/instructions/rfc-keywords.md",
    "~/.config/opencode/instructions/output-protocol.md",
    "~/.config/opencode/instructions/verification-honesty.md",
    "~/.config/opencode/instructions/routing-index.md",
    "~/.config/opencode/instructions/git-safety.md"
  ],
  "plugins": [],
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "node",
          "-e",
          "import(require('url').pathToFileURL(require('path').join(require('os').homedir(), '.config/opencode/scripts/serena-workspace-daemon.mjs')).href)"
        ],
        "install": "uv tool install -p 3.13 serena-agent@latest --prerelease=allow",
        "disabled": true
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "install": "npm install -g @colbymchenry/codegraph",
        "disabled": false
      },
      "gitnexus": {
        "type": "local",
        "command": ["gitnexus", "mcp"],
        "install": "npm install -g gitnexus",
        "environment": { "GITNEXUS_MCP_READ_ONLY": "1" },
        "disabled": true
      },
      "dbhub": {
        "type": "local",
        "command": ["dbhub", "--transport", "stdio", "--config", "./dbhub.toml"],
        "install": "npm install -g @bytebase/dbhub",
        "disabled": true
      },
      "headroom": {
        "type": "local",
        "command": [
          "node",
          "-e",
          "import(require('url').pathToFileURL(require('path').join(require('os').homedir(), '.config/opencode/scripts/headroom-proxy-daemon.mjs')).href)"
        ],
        "install": "uv tool install --python 3.13 \"headroom-ai[all]\"",
        "disabled": true
      },
      "idea": {
        "type": "remote",
        "url": "http://127.0.0.1:64342/stream",
        "disabled": true
      }
    }
  },
  "agents": {
    "general": { "disabled": true },
    "lite": {
      "description": "Lite — default primary agent. Lean, capable, ready for anything: quick fixes, lookups, Q&A, small edits, drafting, analysis. Escalates to @code/@build when out of scope. No L0/MCP; skills limited to handoff, memory-summarize, and git-merge/git-pick/git-pull/git-push/git-rebase.",
      "system": "<!-- lite-mode -->\n{file:~/.config/opencode/prompts/lite.md}",
      "mode": "primary",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "tgrep_search", "resource": "*", "effect": "allow" },
        { "action": "memory_note", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "handoff", "effect": "allow" },
        { "action": "skill", "resource": "memory-summarize", "effect": "allow" },
        { "action": "skill", "resource": "git-merge", "effect": "allow" },
        { "action": "skill", "resource": "git-pick", "effect": "allow" },
        { "action": "skill", "resource": "git-pull", "effect": "allow" },
        { "action": "skill", "resource": "git-rebase", "effect": "allow" },
        { "action": "skill", "resource": "git-push", "effect": "allow" }
      ]
    },
    "code": {
      "description": "Code — direct developer. Primary agent that does the coding work itself: implement, fix, refactor, test. Never proactively delegates; manual delegation allowed only for assists (advisor, explore, code-review-fast, code-review, vision). For single-domain tasks; suggests @build when multi-domain.",
      "system": "{file:~/.config/opencode/prompts/code.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "primary",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "build": {
      "description": "Build — multi-domain orchestrator with full capability. Defaults to dispatching specialists (plan first on 3+ domains); may do bounded direct work when a round-trip costs more than the fix. Coordinates multi-step workflows, integrates results, verifies the final state.",
      "system": "{file:~/.config/opencode/prompts/build.md}",
      "mode": "primary",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "tgrep_search", "resource": "*", "effect": "allow" },
        { "action": "memory_note", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "plan": {
      "description": "Plan orchestrator — coordinator that dispatches analysis tasks to specialists, persists structured plan artifacts (docs/plan/<topic>.md), and provides clean execution handoffs.",
      "system": "{file:~/.config/opencode/prompts/plan.md}",
      "mode": "primary",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "tgrep_search", "resource": "*", "effect": "allow" },
        { "action": "memory_note", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },
    "scout": {
      "description": "Scout — built-in override for short, read-only reconnaissance. Locates files, symbols, and direct dependencies; routes review or audit requests to @build. Never reviews or calls graph MCP tools.",
      "system": "{file:~/.config/opencode/prompts/scout.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      "steps": 12,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "rtk git diff *", "effect": "allow" },
        { "action": "shell", "resource": "rtk git status *", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "explore": {
      "description": "Fast read-only codebase explorer. Use for quick code search, file location by pattern, keyword search, codebase Q&A, architecture overviews, and intent & design questions — any thoroughness from targeted lookup to thorough analysis. Structural lookups (definitions, references, symbol outlines) go to Serena MCP tools; multi-hop call paths and impact analysis go to CodeGraph instead.",
      "system": "{file:~/.config/opencode/prompts/explore.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      "steps": 40,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "advisor": {
      "description": "Decision advisor — provides independent second-opinion analysis on blocking decisions. Invoke when the orchestrator needs a second perspective before presenting a blocking decision to the user.",
      "system": "{file:~/.config/opencode/prompts/advisor.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "steps": 25,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "researcher": {
      "description": "Tech researcher — evaluates technologies, compares alternatives, produces feasibility studies and trade-off reports. Invoke for research, compare, evaluate, benchmark, or 'which should we use?' questions.",
      "system": "{file:~/.config/opencode/prompts/researcher.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "architect": {
      "description": "Tech lead / software architect — system design, ADRs, task decomposition, trade-off analysis, API contract design. Invoke for architecture, system design, task breakdown, or 'how should we design this?'",
      "system": "{file:~/.config/opencode/prompts/architect.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.4 } },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "sdd-workflow", "effect": "allow" },
        { "action": "skill", "resource": "adr-protocol", "effect": "allow" },
        { "action": "skill", "resource": "adr-context", "effect": "allow" },
        { "action": "skill", "resource": "adr-compaction", "effect": "allow" },
        { "action": "serena_*", "resource": "*", "effect": "deny" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "dba": {
      "description": "Database architect — schema design, SQL optimization, index strategy, query analysis, migration planning, sharding/partitioning. Invoke for database, SQL, schema, migration, index, or query optimization.",
      "system": "{file:~/.config/opencode/prompts/dba.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}\n\n{file:~/.config/opencode/instructions/sql-migration.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "allow" },
        { "action": "codegraph_*", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "allow" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "security": {
      "description": "Security engineer — vulnerability assessment, security architecture review, OWASP analysis, dependency scanning, compliance. Invoke for security, vulnerability, OWASP, encryption, or 'is this secure?'",
      "system": "{file:~/.config/opencode/prompts/security.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.2 } },
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "serena_*", "resource": "*", "effect": "allow" },
        { "action": "codegraph_*", "resource": "*", "effect": "allow" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "allow" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "java-dev": {
      "description": "Java/Spring Boot engineer — Java, Spring Boot, Spring Security, JPA/Hibernate, Maven/Gradle, JUnit. Invoke for Java, Spring, JPA, Hibernate, Maven, Gradle, or JVM tasks.",
      "system": "{file:~/.config/opencode/prompts/java-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "python-dev": {
      "description": "Python engineer — FastAPI, Django, Flask, async Python, pandas/numpy, scripting, pytest. Invoke for Python, FastAPI, Django, Flask, pandas, numpy, or pip tasks.",
      "system": "{file:~/.config/opencode/prompts/python-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "go-dev": {
      "description": "Go engineer — Gin, Echo, Fiber, gRPC, protobuf, Cobra, microservices, goroutines. Invoke for Go, Golang, Gin, gRPC, protobuf, or Cobra tasks.",
      "system": "{file:~/.config/opencode/prompts/go-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "rust-dev": {
      "description": "Rust engineer — Cargo, Axum, Actix, Tokio, serde, WASM, systems programming. Invoke for Rust, Cargo, Tokio, Axum, Actix, serde, or wasm tasks.",
      "system": "{file:~/.config/opencode/prompts/rust-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "node-dev": {
      "description": "Node.js/TypeScript engineer — NestJS, Express, Fastify, Prisma, TypeORM, npm/pnpm. Invoke for Node.js, NestJS, Express, Fastify, Prisma, TypeORM, or npm/pnpm tasks.",
      "system": "{file:~/.config/opencode/prompts/node-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "gitnexus_*", "resource": "*", "effect": "deny" },
        { "action": "dbhub_*", "resource": "*", "effect": "deny" },
        { "action": "idea_*", "resource": "*", "effect": "deny" },
        { "action": "headroom_*", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "frontend-dev": {
      "description": "Frontend engineer — React/Vue/Svelte/Next.js, TypeScript, CSS/Tailwind, accessibility, performance. Invoke for frontend, React, Vue, Svelte, CSS, Tailwind, UI, or component work.",
      "system": "{file:~/.config/opencode/prompts/frontend-dev.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "subagent",
      "request": { "body": { "temperature": 0.3 } },
      "permissions": [
