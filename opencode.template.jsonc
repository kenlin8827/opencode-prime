{
  // Installer-only retirement list: factory agents deleted from the `agent`
  // block below. On upgrade the merger drops them from the preserved target
  // config and tiers.json — without this they would be misread as user-added
  // agents and preserved forever. Consumed by install/src/merger.ts and
  // stripped from the merged output; never reaches the opencode runtime.
  "removed_agents": ["coworker", "explorer"],
  "$schema": "https://opencode.ai/config.json",
  "snapshot": true,
  // No root `model`/`small_model` and no per-agent `model` presets below:
  // a fresh install must work before any profile is applied, so every
  // agent inherits opencode's own default model. `/profile apply` then
  // materializes the tiers.json mapping into per-agent model refs and sets
  // root `model` (tier.standard) + `small_model` (tier.flash).
  "default_agent": "lite",
  "permission": "allow",
  // L0 disclosure layer — injected into EVERY step of EVERY agent. Entries
  // MUST use absolute ~/ paths: opencode resolves relative instruction paths
  // against the current project directory (globUp from the working dir), not
  // the config dir — a relative entry would silently fail to load in any
  // project that lacks a matching instructions/*.md. Keep this array small,
  // static, and ordered (prefix-cache friendly). Role rules live at L1 (agent
  // prompt {file:} assembly below); scenario rules at L2 (skills/).
  "instructions": [
    "~/.config/opencode/instructions/rfc-keywords.md",
    "~/.config/opencode/instructions/output-protocol.md",
    "~/.config/opencode/instructions/verification-honesty.md",
    "~/.config/opencode/instructions/routing-index.md",
    "~/.config/opencode/instructions/git-safety.md"
  ],
  // Default active external npm plugins. Optional plugins (opencode-qoder-bridge,
  // opencode-mem, etc.) are managed and enabled via install/options.jsonc.
  // Session titles use opencode's NATIVE title pipeline (built-in `title`
  // agent). `small_model` is unset until /profile apply writes it (flash
  // tier), so title generation and other host utility calls run on the
  // cheapest configured model — resolved with the host's own
  // protocol/credential handling. If the small-model call fails, opencode
  // leaves the default title; no plugin involved.
  "plugin": [],
  // Serena: LSP-based semantic code retrieval (symbol-level queries instead of
  // full file reads) — shared by all agents, avoids duplicate file reads.
  // CLI provisioning: the install script runs the `install` field automatically
  // when `serena` is missing from PATH (requires uv; then `uv tool update-shell`
  // once so ~/.local/bin is on PATH — see the opencode-prime install output).
  // Uses the `ide` context: basic file ops (read_file, list_dir, find_file,
  // create_text_file) and the shell are excluded — those stay with the agents'
  // native tools. Serena's symbolic EDITING/refactoring tools remain exposed;
  // to make it strictly read-only, exclude them per project in
  // .serena/project.yml (`excluded_tools`). `--project-from-cwd` activates the project
  // at the current working directory (.serena/project.yml or .git detected).
  // `--open-web-dashboard False`: the dashboard still runs in the background
  // (tray icon / http://localhost:24282/dashboard/) but no UI window pops up
  // per session — without this, every opencode conversation opens one.
  // If serena is not installed, set "enabled": false — agents fall back to
  // grep/glob/file reads per their prompts. Default off: 23 tools cost
  // ~7.7k tok/step; enable when semantic search / refactoring is needed.
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "import(require('url').pathToFileURL(require('path').join(require('os').homedir(), '.config/opencode/scripts/serena-workspace-daemon.mjs')).href)"
      ],
      "install": "uv tool install -p 3.13 serena-agent@latest --prerelease=allow",
      "enabled": false
    },
    // CodeGraph (default graph backend): pre-indexed code knowledge graph
    // (Tree-sitter → SQLite). Complements Serena: adds structural macro
    // queries — "how does X work" / flows, impact/blast radius, dependency
    // chains, area surveys, framework-aware
    // routes. MIT licensed. Fixed tool surface: a single `codegraph_explore`.
    // Index lifecycle: ONE-TIME manual `codegraph init` per repo (MCP does NOT
    // auto-build a missing index); after that a built-in file watcher keeps it
    // in sync on every save + reconciliation on reconnect — never stale.
    // CLI provisioning: the install script runs the `install` field
    // automatically when `codegraph` is missing (requires npm).
    // "enabled": false to skip.
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "install": "npm install -g @colbymchenry/codegraph",
      "enabled": true
    },
    // GitNexus (optional): deeper graph analysis — arbitrary Cypher, Web UI
    // visualization, precomputed processes/clusters, multi-repo groups.
    // NOTE: PolyForm Noncommercial license — commercial use needs licensing.
    // Requires manual re-index (`gitnexus analyze`) after big changes.
    // One MCP server serves every indexed repo (registry ~/.gitnexus/).
    // GITNEXUS_MCP_READ_ONLY=1: read-only graph tools only — edits stay with
    // the agents' native tools. "enabled": true only if licensed + indexed.
    // `install` is pre-declared but dormant: while "enabled" stays false the
    // install script skips it; flipping enabled to true makes the next install
    // provision the CLI automatically (licensing + per-repo `gitnexus analyze`
    // remain your decision).
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus", "mcp"],
      "install": "npm install -g gitnexus",
      "env": { "GITNEXUS_MCP_READ_ONLY": "1" },
      "enabled": false
    },
    // DBHub (optional): universal database gateway — PostgreSQL, MySQL,
    // MariaDB, SQL Server, SQLite through one server. Token-efficient:
    // 2 tools by default (~1.4k tokens). Bytebase project, MIT licensed.
    // Requires Node >= 22.5. Configuration is PER-PROJECT, not shipped:
    // dbhub auto-discovers ./dbhub.toml from the working directory (or
    // --config / DSN env var). TOML values support ${ENV_VAR} interpolation
    // — keep credentials out of any repo. Read-only is enforced per tool
    // in the TOML ([[tools]] readonly = true); the old --readonly flag is
    // removed upstream. Enabled by default in install/options.jsonc, so
    // installs provision the CLI and flip `enabled` — the false below is
    // only the shipped template fallback (direct copies without the
    // installer). dbhub.toml + DSN in each project remain your setup.
    // Example dbhub.toml in the project root:
    //   [[sources]]
    //   id = "default"
    //   dsn = "${DBHUB_DSN}"
    //   [[tools]]
    //   name = "execute_sql"
    //   source = "default"
    //   readonly = true
    "dbhub": {
      "type": "local",
      "command": ["dbhub", "--transport", "stdio", "--config", "./dbhub.toml"],
      "install": "npm install -g @bytebase/dbhub",
      "enabled": false
    },
    // Headroom (optional): local context compression — compresses tool outputs,
    // logs, and RAG chunks before they reach the LLM; originals stay
    // retrievable on demand via CCR (`headroom_retrieve`). Apache 2.0,
    // local-first. Complements rtk, which covers the OUTPUT side —
    // headroom targets the INPUT side.
    // MCP mode is agent-driven (compress on
    // demand); the fully automatic `headroom proxy` mode is NOT wired in here
    // because it rewrites provider base URLs. Heavy provisioning: uv tool
    // with Python 3.13, and the first run downloads the ONNX runtime
    // (cdn.pyke.io) + Kompress compression model (huggingface.co). Flip
    // "enabled" to true only if you accept those downloads.
    // Daemon bridge: uses headroom-proxy-daemon.mjs (same pattern as
    // serena-workspace-daemon.mjs). Checks whether the headroom proxy backend
    // (127.0.0.1:8787) is running; if not, spawns `headroom proxy` detached
    // in the background, waits for readiness, then exec's `headroom mcp serve`.
    // Makes headroom fully out-of-the-box — no manual `headroom proxy` step.
    "headroom": {
      "type": "local",
      "command": [
        "node",
        "-e",
        "import(require('url').pathToFileURL(require('path').join(require('os').homedir(), '.config/opencode/scripts/headroom-proxy-daemon.mjs')).href)"
      ],
      "install": "uv tool install --python 3.13 \"headroom-ai[all]\"",
      "enabled": false
    },
    // JetBrains IDE MCP bridge — remote server exposed by the running IDE
    // (IntelliJ / WebStorm / etc.) on the local stream endpoint. No CLI to
    // install; the IDE must be running with its MCP server enabled.
    //
    // IDE-side setup (one-time per project):
    //   1. Install the "MCP Server" plugin (JetBrains Marketplace) if not
    //      already bundled by your IDE version.
    //   2. Open: Settings (Preferences) → Tools → MCP Server.
    //   3. Toggle the server ON and apply. The IDE starts listening on
    //      127.0.0.1:64342/stream — verify the port matches.
    //   4. Keep the IDE running; this endpoint dies when the IDE closes.
    //
    // Then flip "enabled" here (or via install/options.jsonc) to connect.
    "idea": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream",
      "enabled": false
    }
  },
  // L1 disclosure layer: each agent prompt = its own prompts/*.md plus the
  // rule files its role actually needs, assembled via {file:} markers (order
  // fixed: agent prompt first, then rules). {file:} resolves ONLY inside this
  // config's prompt fields (verified v1.18.25). Prompt fragments MUST NOT live
  // under agents/ in the installed config: opencode auto-discovers agents/*.md
  // as agent DEFINITIONS whose frontmatter/body silently override this block
  // (mergeDeep, md wins) — that killed every permission and {file:} assembly
  // here before v0.17.0. prompts/ is not auto-discovered. Routing matrix:
  //   coding pack (coding-principles + comment-strategy + edit-protocol +
  //   test-scope): code, fast-coder, the six language devs, devops, qa
  //   coding pack + sql-migration: dba
  //   coding-principles + comment-strategy + test-scope: code-review (edit denied)
  //   shared review body + coding-principles: code-review-fast (edit denied; P0/P1 triage)
  //   graph-only relationship evidence: codegraph-scout, gitnexus-scout (no native tool surface)
  //   coding-principles only (review criteria): architect, advisor, security
  //   zero additions: build, plan, scout, explore, researcher, tech-writer, vision
  //
  // Block field order (convention): description, prompt, then tuning
  // metadata (mode/model/temperature/steps/variant), permission/tools last.
  //
  // Per-step visibility & tool-face policy lives HERE, on the agent blocks
  // below, as native opencode `permission`/`tools` fields. Semantics
  // (opencode v1.18.25, verified against permission/index.ts):
  // `"<prefix>*": { "*": "deny" }` hides MCP tools AND the server's
  // <mcp_instructions> block; skill "*" deny empties the skills block;
  // tools <name>:false removes a native tool schema entirely (permission
  // denies on native tools save zero tokens). Protocol-injector gating (an
  // opencode gap) lives in plugin-scope.json (repo root), enforced at
  // runtime by plugins/shared/plugin-scope.ts. Quantify any change with
  // scripts/measure-prompts.ts before releasing.
  //
  // MCP deny set: opencode has no permission inheritance or $ref — each
  // agent block is independent. The MCP-deny set (serena/codegraph/
  // gitnexus/dbhub/idea) is duplicated across: build, plan, researcher,
  // tech-writer, vision, code-review, and code-review-fast (lite uses
  // "*":deny instead — it has a tools whitelist). Graph scouts expose one
  // backend query each, keeping graph tool schemas off reviewers.
  // Adding/removing an MCP server here → grep "serena_\*"
  // across this file to update ALL deny blocks in one pass.
  //
  // L2 layer: `lite` is the default agent — overhead-free primary, inline
  // prompt, skills scoped to the agent-less handoff + Git commands,
  // no MCP, OCP injectors skip it via plugin-scope.json,
  // plugins/lite-mode.ts strips L0 instructions (keeping the `<!-- lite-mode -->`
  // sentinel), and plugins/lite-tools.ts compresses native tool descriptions
  // (measured: stock ≈ 8.4k → ≈ 1.7k tok/step). Lite handles 80% of daily work
  // (quick fixes, Q&A, lookups, small edits) at ~2.3k tok/step — 62% cheaper
  // than code's ~5.4k. Escalation table in lite.md routes complex work to
  // @code/@build/@code-review-fast/@code-review/@advisor when out of scope.
  "agent": {
    // Native subagents disabled: `explore`'s role is owned by the factory
    // `explore` agent below (the name captures models' training priors —
    // Claude Code/opencode convention; formerly our agent was `explorer` and
    // models kept picking the native one instead), and `general` overlaps
    // the build team. Natives carry no `model` config, so the task tool's
    // fallback (`next.model ?? parent message model`, verified v1.18.25)
    // would silently run them on the host's model instead of a tier preset.
    "general": { "disable": true },
    "lite": {
      "description": "Lite — default primary agent. Lean, capable, ready for anything: quick fixes, lookups, Q&A, small edits, drafting, analysis. Escalates to @code/@build when out of scope. No L0/MCP; skills limited to handoff and git-merge/git-pick/git-pull/git-push/git-rebase.",
      "prompt": "<!-- lite-mode -->\n{file:~/.config/opencode/prompts/lite.md}",
      "mode": "primary",
      "temperature": 0.3,
      // No variant pin: lite's slimness comes from prompt surgery (no L0/MCP,
      // skills scoped to two, compressed tool schemas), not model quality — it rides the standard
      // tier and inherits the model's native default (ChatGPT-style auto/standard,
      // Kimi-style thinking-on). Forcing "low" would demote a user-facing daily
      // primary; throughput agents (explore, fast-coder) keep their explicit low.
      // Cost-shrinking: "*": { "*": "deny" } hides all MCP tool definitions
      // plus <mcp_instructions>. tools:false drops every heavy native schema;
      // the whitelist keeps the minimal capable set lite needs (read/edit/
      // write/bash/grep/glob/webfetch/websearch/todowrite/task/question).
      // `question` (interactive ask) is back on lite after token measurement
      // showed it costs only ~216 tok/step with the lite-tools description
      // override (schema ~198 tok + one-line desc) — worth it because lite is
      // the default primary and its git-safety flow promises Proceed/Cancel.
      // Discipline lives in lite.md: at most one blocking question per task.
      // No `list` — opencode has no such tool; `read` auto-lists directories.
      // lite-tools.ts compresses only the description (the bulk — bash's
      // usage guide alone is ~1.8k tok). Parameters/jsonSchema stay native:
      // they're already small (~100 tok/tool) and hand-overriding them risks
      // field-name mismatches that break tool calls at runtime. task whitelists
      // assists: @explore, @code-review-fast, @code-review, @advisor, @vision (last match wins).
      // Dispatch policy is hardcoded in the prompt: assists fire only on
      // explicit user request, sole exception @vision for images beyond lite's
      // own sight (zero-alternative path). Lite is a leaf — heavy or
      // multi-domain coding escalates to @code or @build by the user.
      "permission": {
        "*": { "*": "deny" },
        // external_directory (any path outside the project worktree, %TEMP%
        // included) needs this explicit punch-through: the catch-all above is
        // the last matching rule for it (last-match-wins), so without it lite
        // hard-denies read/edit/glob/grep on external paths. opencode's native
        // default is "ask"; every other agent here inherits the root
        // "permission": "allow" and needs no such key.
        "external_directory": { "*": "allow" },
        // Scoped skill access: /handoff and the five Git commands have no
        // `agent:` frontmatter, so they follow the current agent — and lite is
        // the default. Allow exactly those six skills; every other skill stays
         // denied so the skills block remains minimal (token economy). The more
        // specific `skill` key overrides the catch-all `"*"` above; inside it
        // the allows beat `"*": "deny"` (last-match-wins, same rule as
        // explore's bash gate).
        "skill": {
          "*": "deny",
          "handoff": "allow",
          "git-merge": "allow",
          "git-pick": "allow",
          "git-pull": "allow",
          "git-rebase": "allow",
          "git-push": "allow"
        }
      },
      "tools": {
        "*": false,
        "read": true,
        "edit": true,
        "write": true,
        "bash": true,
        "grep": true,
        "glob": true,
        "webfetch": true,
        "websearch": true,
        "todowrite": true,
        "task": true,
        "skill": true,
        "question": true,
        "tgrep_search": true
      }
    },
    "code": {
      "description": "Code — direct developer. Primary agent that does the coding work itself: implement, fix, refactor, test. Never proactively delegates; manual delegation allowed only for assists (advisor, explore, code-review-fast, code-review, vision). For single-domain tasks; suggests @build when multi-domain.",
      "prompt": "{file:~/.config/opencode/prompts/code.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}",
      "mode": "primary",
      "temperature": 0.3,
      "variant": "medium"
    },
    "build": {
      "description": "Build — default entry point for all tasks. Routes every coding task to the right specialist agent (even simple ones); handles only non-coding tasks (exploration, Q&A, git info) directly. Coordinates multi-step workflows across agents.",
      "prompt": "{file:~/.config/opencode/prompts/build.md}",
      "mode": "primary",
      "temperature": 0.3,
      "variant": "medium",
      // Build routes work, it doesn't do it — hide the MCP tool surface
      // (~10.9k tok/step): serena/codegraph when on, plus the optional
      // graph/DB/IDE servers if the user enables them (DB queries belong to
      // @dba). sdd-workflow stays: /prd /sdd land here.
      "permission": {
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      }
    },
    "plan": {
      "description": "Plan orchestrator — coordinator that dispatches analysis tasks to specialists, persists structured plan artifacts (docs/plan/<topic>.md), and provides clean execution handoffs.",
      "prompt": "{file:~/.config/opencode/prompts/plan.md}",
      "mode": "primary",
      "temperature": 0.3,
      "variant": "medium",
      // Plan dispatches analysis to specialists — no direct code-intel calls;
      // optional graph/DB/IDE servers stay hidden too. SDD stays: /prd /adr
      // /plan /impl run from here.
      "permission": {
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      }
    },
    // Task delegation policy: subagents are leaf nodes — task:false on every subagent; delegation belongs to the primaries (build/plan/code).
    // Ordering = dispatch frequency: explore leads (it opens almost every workflow), so it also heads the task tool's candidate list.
    "scout": {
      "description": "Scout — built-in override for short, read-only reconnaissance. Locates files, symbols, and direct dependencies; routes review or audit requests to @build. Never reviews or calls graph MCP tools.",
      "prompt": "{file:~/.config/opencode/prompts/scout.md}",
      "mode": "subagent",
      "temperature": 0.2,
      "steps": 12,
      "variant": "low",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git status*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "headroom_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "explore": {
      "description": "Fast read-only codebase explorer. Use for quick code search, file location by pattern, keyword search, codebase Q&A, architecture overviews, and intent & design questions — any thoroughness from targeted lookup to thorough analysis. Structural lookups (definitions, references, symbol outlines) go to Serena MCP tools; multi-hop call paths and impact analysis go to CodeGraph instead.",
      "prompt": "{file:~/.config/opencode/prompts/explore.md}",
      "mode": "subagent",
      "temperature": 0.2,
      "steps": 40,
      "variant": "low",
      // Read-only enforced via granular bash: only read-only git inspection
      // survives (last match wins); every other command is denied.
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git blame*": "allow",
          "git status*": "allow",
          "rtk git log*": "allow",
          "rtk git show*": "allow",
          "rtk git diff*": "allow",
          "rtk git status*": "allow"
        },
        "webfetch": "deny",
        "websearch": "deny",
        "skill": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "advisor": {
      "description": "Decision advisor — provides independent second-opinion analysis on blocking decisions. Invoke when the orchestrator needs a second perspective before presenting a blocking decision to the user.",
      "prompt": "{file:~/.config/opencode/prompts/advisor.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "temperature": 0.3,
      "steps": 25,
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "researcher": {
      "description": "Tech researcher — evaluates technologies, compares alternatives, produces feasibility studies and trade-off reports. Invoke for research, compare, evaluate, benchmark, or 'which should we use?' questions.",
      "prompt": "{file:~/.config/opencode/prompts/researcher.md}",
      "mode": "subagent",
      "temperature": 0.3,
      "variant": "medium",
      // Web/tech research runs outside the codebase — hide the MCP tool
      // surface (including the optional graph/DB/IDE servers if enabled).
      // bash stays: benchmarks and trial CLIs are core research work.
      "permission": {
        "edit": "deny",
        "skill": { "*": "deny" },
        "serena_*": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" },
        "dbhub_*": { "*": "deny" },
        "idea_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "architect": {
      "description": "Tech lead / software architect — system design, ADRs, task decomposition, trade-off analysis, API contract design. Invoke for architecture, system design, task breakdown, or 'how should we design this?'",
      "prompt": "{file:~/.config/opencode/prompts/architect.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "temperature": 0.4,
      "variant": "high",
      // Advisory role — environment facts arrive via explore/researcher; no
      // direct execution.
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "dba": {
      "description": "Database architect — schema design, SQL optimization, index strategy, query analysis, migration planning, sharding/partitioning. Invoke for database, SQL, schema, migration, index, or query optimization.",
      "prompt": "{file:~/.config/opencode/prompts/dba.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}\n\n{file:~/.config/opencode/instructions/comment-strategy.md}\n\n{file:~/.config/opencode/instructions/edit-protocol.md}\n\n{file:~/.config/opencode/instructions/test-scope.md}\n\n{file:~/.config/opencode/instructions/sql-migration.md}",
      "mode": "subagent",
      "temperature": 0.2,
      "variant": "medium",
      "permission": {
        "skill": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "security": {
      "description": "Security engineer — vulnerability assessment, security architecture review, OWASP analysis, dependency scanning, compliance. Invoke for security, vulnerability, OWASP, encryption, or 'is this secure?'",
      "prompt": "{file:~/.config/opencode/prompts/security.md}\n\n{file:~/.config/opencode/instructions/coding-principles.md}",
      "mode": "subagent",
      "temperature": 0.2,
      "variant": "high",
      // bash stays: dependency scanners (npm audit, pip-audit, trivy, gitleaks)
      // are core security work; edits stay denied.
      "permission": {
        "edit": "deny",
        "skill": { "*": "deny" },
        "codegraph_*": { "*": "deny" },
        "gitnexus_*": { "*": "deny" }
      },
      "tools": { "task": false }
    },
    "java-dev": {
