// Supplementary coding-plan point rates and a last-resort USD lower bound.
// Update provider sources/rates when schedules change; installer copies this to models/cost.jsonc.

{
  "$comment": "OCP supplementary — coding-plan points + last-resort USD price floor. Add a new top-level provider key to register a new plan; add models under its rates map. Drop the unused provider block to remove support.",

  // USD lower bound when server billing and rate lookup both miss; per 1M tokens.
  "killLineUSD": {
    "input": 0.06,
    "cached": 0.012,
    "output": 0.12,
    "source": "https://mappedinfo.github.io/llm-price-kill-line/"
  },

  "providers": {
    "zhipuai-coding-plan": {
      "credits": true,
      "source": "https://docs.bigmodel.cn/cn/coding-plan/overview",
      "divisor": 10000,
      "rates": {
        // GLM-5.3-Flash, including visual MCP.
        "glm-5.3-flash":  { "input": 2.3,  "cached": 0.56, "output": 8 },
        // Aliases route to GLM-5.3-Flash per the provider spec.
        "glm-5-turbo":    { "input": 2.3,  "cached": 0.56, "output": 8 },
        "glm-4.7":        { "input": 2.3,  "cached": 0.56, "output": 8 },

        "glm-5.3":        { "input": 6.9,  "cached": 1.7,  "output": 24 },
        // Aliases route to GLM-5.3 per the provider spec.
        "glm-5.2":        { "input": 6.9,  "cached": 1.7,  "output": 24 },
        "glm-5.1":        { "input": 6.9,  "cached": 1.7,  "output": 24 }
      }
    },

    "zai-coding-plan": {
      "credits": true,
      "source": "https://docs.z.ai/devpack/overview",
      "divisor": 10000,
      "rates": {
        // Separate provider key permits future schedule divergence.
        "glm-5.3-flash":  { "input": 2.3,  "cached": 0.56, "output": 8 },
        "glm-5-turbo":    { "input": 2.3,  "cached": 0.56, "output": 8 },
        "glm-4.7":        { "input": 2.3,  "cached": 0.56, "output": 8 },

        "glm-5.3":        { "input": 6.9,  "cached": 1.7,  "output": 24 },
        "glm-5.2":        { "input": 6.9,  "cached": 1.7,  "output": 24 },
        "glm-5.1":        { "input": 6.9,  "cached": 1.7,  "output": 24 }
      }
    }
  }
}
