        "linux-x64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/BurntSushi/ripgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"15.2.0\"; curl -fsSL \"https://github.com/BurntSushi/ripgrep/releases/download/${tag}/ripgrep-${tag}-x86_64-unknown-linux-musl.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp/ripgrep-${tag}-x86_64-unknown-linux-musl\" -type f -name rg | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/rg\"",
