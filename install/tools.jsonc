// Optional external-tool registry. options.jsonc selects tools; this file declares
// their metadata and platform-aware install/upgrade commands.
// Resolution: platform-arch -> platform -> default; null skips that platform.
{
  "tools": {
    "rtk": {
      "description": "Rust Token Killer — token-optimized shell command proxy",
      "binary": "rtk",
      "url": "https://github.com/rtk-ai/rtk",
      "install": {
        "default": "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh",
        "win32-x64": "$cmd=Get-Command rtk -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local\\bin\\rtk.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$zip=Join-Path $tmp 'rtk.zip'; Invoke-WebRequest -Uri 'https://github.com/rtk-ai/rtk/releases/latest/download/rtk-x86_64-pc-windows-msvc.zip' -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; Copy-Item -Path (Join-Path $tmp 'rtk.exe') -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}"
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "rtk-ai/rtk"
        },
        "upgrade": {
          "default": "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh",
          "win32-x64": "$cmd=Get-Command rtk -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local\\bin\\rtk.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$zip=Join-Path $tmp 'rtk.zip'; Invoke-WebRequest -Uri 'https://github.com/rtk-ai/rtk/releases/latest/download/rtk-x86_64-pc-windows-msvc.zip' -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; Copy-Item -Path (Join-Path $tmp 'rtk.exe') -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}"
        }
      }
    },
    "herdr": {
      "description": "Terminal workspace manager for AI coding agents",
      "binary": "herdr",
      "url": "https://herdr.dev",
      "install": {
        "default": "npm install -g herdr-cli",
        "win32-x64": "iwr https://herdr.dev/install.ps1 -useb | iex",
        "darwin-arm64": "curl -fsSL https://herdr.dev/install.sh | sh",
        "linux-x64": "curl -fsSL https://herdr.dev/install.sh | sh"
      },
      "post_install": [
        {
          "name": "install-opencode-integration",
          "when": "opencode",
          "command": "node \"$OCP_REPO_DIR/install/scripts/herdr-recovery.js\" integration install opencode"
        },
        {
          "name": "link-ocp-auto-opencode-plugin",
          "when": "opencode",
          "command": "node \"$OCP_REPO_DIR/install/scripts/herdr-recovery.js\" plugin link \"$OCP_REPO_DIR/install/herdr-plugins/auto-opencode\""
        }
      ],
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "herdrdev/herdr"
        },
        "upgrade": {
          "default": "npm install -g herdr-cli@latest",
          "win32-x64": "iwr https://herdr.dev/install.ps1 -useb | iex",
          "darwin-arm64": "curl -fsSL https://herdr.dev/install.sh | sh",
          "linux-x64": "curl -fsSL https://herdr.dev/install.sh | sh"
        }
      }
    },
    "luvus": {
      "description": "Luvus AI-agent workspace manager — powers `ocp tui` when tui_mode is `luvus`",
      "binary": "luvus",
      "url": "https://luvus.dev",
      "install": {
        "default": "curl -fsSL https://luvus.dev/install.sh | sh",
        "win32-x64": "irm https://luvus.dev/install.ps1 | iex",
        "darwin-arm64": "curl -fsSL https://luvus.dev/install.sh | sh",
        "linux-x64": "curl -fsSL https://luvus.dev/install.sh | sh"
      },
      "post_install": [
        {
          "name": "install-opencode-integration",
          "when": "opencode",
          "command": "luvus integration install opencode"
        },
        {
          "name": "link-ocp-auto-opencode-module",
          "when": "opencode",
          "command": "luvus module link \"$OCP_REPO_DIR/install/luvus-modules/auto-opencode\""
        }
      ],
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "RizRiyz/luvus"
        },
        "upgrade": {
          "default": "luvus update",
          "win32-x64": "luvus update",
          "darwin-arm64": "luvus update",
          "linux-x64": "luvus update"
        }
      }
    },
    "openchamber_web": {
      "description": "OpenChamber web UI CLI — powers `ocp web`",
      "binary": "openchamber",
      "url": "https://openchamber.dev",
      "install": {
        "default": "npm install -g @openchamber/web"
      },
      "update_check": {
        "source": {
          "kind": "npm",
          "package": "@openchamber/web"
        },
        "upgrade_strategy": "smart",
        "upgrade_package": "@openchamber/web",
        "upgrade": {
          "default": "npm install -g @openchamber/web@latest"
        }
      }
    },
    "openchamber_desktop": {
      "description": "OpenChamber desktop app — powers `ocp desktop` / `ocp ui` (separate download; install only checks presence)",
      "binary": "openchamber-desktop",
      "url": "https://openchamber.dev/download"
    },
    "openchamber_vscode": {
      "description": "OpenChamber editor extension — powers `ocp code` (fedaykindev.openchamber)",
      "binary": "code",
      "url": "https://marketplace.visualstudio.com/items?itemName=fedaykindev.openchamber"
    },
    "tgrep": {
      "description": "Trigram-indexed grep (microsoft/tgrep) — optional full-text index backend for the tgrep_search tool. Presence-only: OCP never downloads it; install a fixed release yourself, then run /project init per repository.",
      "binary": "tgrep",
      "url": "https://github.com/microsoft/tgrep/releases"
    },
    "opencode": {
      "description": "OpenCode — AI coding agent",
      "binary": "opencode",
      "url": "https://opencode.ai",
      "install": {
        "default": "curl -fsSL https://opencode.ai/install | bash",
        "win32-x64": "irm https://opencode.ai/install.ps1 | iex"
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "anomalyco/opencode"
        },
        "upgrade_strategy": "smart",
        "upgrade_package": "opencode-ai",
        "upgrade": {
          "default": "curl -fsSL https://opencode.ai/install | bash",
          "win32-x64": "irm https://opencode.ai/install.ps1 | iex"
        }
      }
    }
  }
}
