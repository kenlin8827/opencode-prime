// Optional external-tool registry. options.jsonc selects tools; this file declares
// their metadata and platform-aware install/upgrade commands.
// Resolution: platform-arch -> platform -> default; null skips that platform.
{
  "tools": {
    "rtk": {
      "description": "Rust Token Killer — token-optimized shell command proxy",
      "binary": "rtk",
      "url": "https://github.com/rtk-ai/rtk",
      "install": {
        "default": "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh",
        "win32-x64": "$cmd=Get-Command rtk -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local\\bin\\rtk.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$zip=Join-Path $tmp 'rtk.zip'; Invoke-WebRequest -Uri 'https://github.com/rtk-ai/rtk/releases/latest/download/rtk-x86_64-pc-windows-msvc.zip' -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; Copy-Item -Path (Join-Path $tmp 'rtk.exe') -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}"
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "rtk-ai/rtk"
        },
        "upgrade": {
          "default": "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh",
          "win32-x64": "$cmd=Get-Command rtk -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local\\bin\\rtk.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$zip=Join-Path $tmp 'rtk.zip'; Invoke-WebRequest -Uri 'https://github.com/rtk-ai/rtk/releases/latest/download/rtk-x86_64-pc-windows-msvc.zip' -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; Copy-Item -Path (Join-Path $tmp 'rtk.exe') -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}"
        }
      }
    },
    "herdr": {
      "description": "Terminal workspace manager for AI coding agents",
      "binary": "herdr",
      "url": "https://herdr.dev",
      "install": {
        "default": "npm install -g herdr-cli",
        "win32-x64": "iwr https://herdr.dev/install.ps1 -useb | iex",
        "darwin-arm64": "curl -fsSL https://herdr.dev/install.sh | sh",
        "linux-x64": "curl -fsSL https://herdr.dev/install.sh | sh"
      },
      "post_install": [
        {
          "name": "install-opencode-integration",
          "when": "opencode",
          "command": "node \"$OCP_REPO_DIR/install/scripts/herdr-recovery.js\" integration install opencode"
        },
        {
          "name": "link-ocp-auto-opencode-plugin",
          "when": "opencode",
          "command": "node \"$OCP_REPO_DIR/install/scripts/herdr-recovery.js\" plugin link \"$OCP_REPO_DIR/install/herdr-plugins/auto-opencode\""
        }
      ],
      // Launch manifest for `ocp tui` (tui_mode=herdr) / `ocp herdr`, executed
      // by install/src/tui-engine.ts. Steps live in
      // install/scripts/engines/herdr/ and own the tool-specific behavior
      // (server bootstrap, workspace dedupe). The agent auto-start itself is
      // the ocp.auto-opencode plugin (pane.created hook), not a launch step.
      "tui": {
        "bin": "herdr",
        "install_hint": "  Install Herdr first: https://herdr.dev (or re-run `ocp install`).",
        "pre_launch": [
          {
            "name": "ensure-server",
            "command": "node \"$OCP_REPO_DIR/install/scripts/engines/herdr/ensure-server.js\""
          },
          {
            "name": "open-workspace",
            "command": "node \"$OCP_REPO_DIR/install/scripts/engines/herdr/open-workspace.js\""
          }
        ]
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "herdrdev/herdr"
        },
        "upgrade": {
          "default": "npm install -g herdr-cli@latest",
          "win32-x64": "iwr https://herdr.dev/install.ps1 -useb | iex",
          "darwin-arm64": "curl -fsSL https://herdr.dev/install.sh | sh",
          "linux-x64": "curl -fsSL https://herdr.dev/install.sh | sh"
        }
      }
    },
    "luvus": {
      "description": "Luvus AI-agent workspace manager — powers `ocp tui` when tui_mode is `luvus`",
      "binary": "luvus",
      "url": "https://luvus.dev",
      "install": {
        "default": "curl -fsSL https://luvus.dev/install.sh | sh",
        "win32-x64": "irm https://luvus.dev/install.ps1 | iex",
        "darwin-arm64": "curl -fsSL https://luvus.dev/install.sh | sh",
        "linux-x64": "curl -fsSL https://luvus.dev/install.sh | sh"
      },
      "post_install": [
        {
          "name": "install-opencode-integration",
          "when": "opencode",
          "command": "luvus integration install opencode"
        },
        {
          "name": "link-ocp-auto-opencode-module",
          "when": "opencode",
          "command": "luvus module link \"$OCP_REPO_DIR/install/luvus-modules/auto-opencode\""
        }
      ],
      // Launch manifest for `ocp tui` (tui_mode=luvus), executed by
      // install/src/tui-engine.ts. Steps live in
      // install/scripts/engines/luvus/: idempotent server start, workspace
      // open, and the warm-start agent guarantee (the ocp.auto-opencode
      // module covers NEW panes via pane.created, but reopening an existing
      // workspace emits no event — start-agent.js closes that gap and works
      // around luvus' Windows `agent start` quoting bug with `pane run`).
      "tui": {
        "bin": "luvus",
        "install_hint": "  Install Luvus first: https://luvus.dev (or re-run `ocp install`).",
        "forward_args": false,
        "args_warning": "[ocp] Luvus mode does not forward OpenCode arguments; launch `ocp` or `ocp tui --direct` to pass arguments to opencode.",
        "pre_launch": [
          {
            "name": "ensure-server",
            "command": "node \"$OCP_REPO_DIR/install/scripts/engines/luvus/ensure-server.js\""
          },
          {
            "name": "open-workspace",
            "command": "node \"$OCP_REPO_DIR/install/scripts/engines/luvus/open-workspace.js\""
          },
          {
            "name": "start-agent",
            "command": "node \"$OCP_REPO_DIR/install/scripts/engines/luvus/start-agent.js\""
          }
        ]
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "RizRiyz/luvus"
        },
        "upgrade": {
          "default": "luvus update",
          "win32-x64": "luvus update",
          "darwin-arm64": "luvus update",
          "linux-x64": "luvus update"
        }
      }
    },
    "openchamber_web": {
      "description": "OpenChamber web UI CLI — powers `ocp web`",
      "binary": "openchamber",
      "url": "https://openchamber.dev",
      "install": {
        "default": "npm install -g @openchamber/web"
      },
      "update_check": {
        "source": {
          "kind": "npm",
          "package": "@openchamber/web"
        },
        "upgrade_strategy": "smart",
        "upgrade_package": "@openchamber/web",
        "upgrade": {
          "default": "npm install -g @openchamber/web@latest"
        }
      }
    },
    "openchamber_desktop": {
      "description": "OpenChamber desktop app — powers `ocp desktop` / `ocp ui` (separate download; install only checks presence)",
      "binary": "openchamber-desktop",
      "url": "https://openchamber.dev/download"
    },
    "openchamber_vscode": {
      "description": "OpenChamber editor extension — powers `ocp code` (fedaykindev.openchamber)",
      "binary": "code",
      "url": "https://marketplace.visualstudio.com/items?itemName=fedaykindev.openchamber"
    },
    "tgrep": {
      "description": "Trigram-indexed grep (microsoft/tgrep) — optional full-text index backend for the tgrep_search tool",
      "binary": "tgrep",
      "url": "https://github.com/microsoft/tgrep/releases",
      "install": {
        "default": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; arch=$(uname -m); case \"$arch\" in x86_64|amd64) arch=\"x86_64\" ;; aarch64|arm64) arch=\"aarch64\" ;; *) echo \"Unsupported arch: $arch\" >&2; exit 1 ;; esac; os=$(uname -s); case \"$os\" in Darwin*) os=\"apple-darwin\" ;; Linux*) os=\"unknown-linux-musl\" ;; *) echo \"Unsupported OS: $os\" >&2; exit 1 ;; esac; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-${arch}-${os}.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
        "win32-x64": "$cmd=Get-Command tgrep -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local/bin/tgrep.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$tag=try{(Invoke-RestMethod -Uri 'https://api.github.com/repos/microsoft/tgrep/releases/latest' -Headers @{'User-Agent'='ocp'}).tag_name}catch{try{$req=[System.Net.HttpWebRequest]::Create('https://github.com/microsoft/tgrep/releases/latest');$req.AllowAutoRedirect=$false;$res=$req.GetResponse();$loc=$res.GetResponseHeader('Location');$res.Close();Split-Path $loc -Leaf}catch{'v1.0.5'}};if(-not $tag){$tag='v1.0.5'};$zip=Join-Path $tmp 'tgrep.zip'; Invoke-WebRequest -Uri \"https://github.com/microsoft/tgrep/releases/download/$tag/tgrep-$tag-x86_64-pc-windows-msvc.zip\" -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; $bin=Get-ChildItem -Path $tmp -Recurse -Filter 'tgrep.exe'|Select-Object -First 1; if(-not $bin){throw 'tgrep.exe not found in archive'}; Copy-Item -Path $bin.FullName -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}",
        "win32-arm64": "$cmd=Get-Command tgrep -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local/bin/tgrep.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$tag=try{(Invoke-RestMethod -Uri 'https://api.github.com/repos/microsoft/tgrep/releases/latest' -Headers @{'User-Agent'='ocp'}).tag_name}catch{try{$req=[System.Net.HttpWebRequest]::Create('https://github.com/microsoft/tgrep/releases/latest');$req.AllowAutoRedirect=$false;$res=$req.GetResponse();$loc=$res.GetResponseHeader('Location');$res.Close();Split-Path $loc -Leaf}catch{'v1.0.5'}};if(-not $tag){$tag='v1.0.5'};$zip=Join-Path $tmp 'tgrep.zip'; Invoke-WebRequest -Uri \"https://github.com/microsoft/tgrep/releases/download/$tag/tgrep-$tag-aarch64-pc-windows-msvc.zip\" -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; $bin=Get-ChildItem -Path $tmp -Recurse -Filter 'tgrep.exe'|Select-Object -First 1; if(-not $bin){throw 'tgrep.exe not found in archive'}; Copy-Item -Path $bin.FullName -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}",
        "darwin-arm64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-aarch64-apple-darwin.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
        "darwin-x64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-x86_64-apple-darwin.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
        "linux-x64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-x86_64-unknown-linux-musl.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
        "linux-arm64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-aarch64-unknown-linux-musl.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\""
      },
      "update_check": {
        "source": {
          "kind": "github",
          "repo": "microsoft/tgrep"
        },
        "upgrade": {
          "default": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; arch=$(uname -m); case \"$arch\" in x86_64|amd64) arch=\"x86_64\" ;; aarch64|arm64) arch=\"aarch64\" ;; *) echo \"Unsupported arch: $arch\" >&2; exit 1 ;; esac; os=$(uname -s); case \"$os\" in Darwin*) os=\"apple-darwin\" ;; Linux*) os=\"unknown-linux-musl\" ;; *) echo \"Unsupported OS: $os\" >&2; exit 1 ;; esac; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-${arch}-${os}.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
          "win32-x64": "$cmd=Get-Command tgrep -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local/bin/tgrep.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$tag=try{(Invoke-RestMethod -Uri 'https://api.github.com/repos/microsoft/tgrep/releases/latest' -Headers @{'User-Agent'='ocp'}).tag_name}catch{try{$req=[System.Net.HttpWebRequest]::Create('https://github.com/microsoft/tgrep/releases/latest');$req.AllowAutoRedirect=$false;$res=$req.GetResponse();$loc=$res.GetResponseHeader('Location');$res.Close();Split-Path $loc -Leaf}catch{'v1.0.5'}};if(-not $tag){$tag='v1.0.5'};$zip=Join-Path $tmp 'tgrep.zip'; Invoke-WebRequest -Uri \"https://github.com/microsoft/tgrep/releases/download/$tag/tgrep-$tag-x86_64-pc-windows-msvc.zip\" -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; $bin=Get-ChildItem -Path $tmp -Recurse -Filter 'tgrep.exe'|Select-Object -First 1; if(-not $bin){throw 'tgrep.exe not found in archive'}; Copy-Item -Path $bin.FullName -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}",
          "win32-arm64": "$cmd=Get-Command tgrep -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local/bin/tgrep.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$tag=try{(Invoke-RestMethod -Uri 'https://api.github.com/repos/microsoft/tgrep/releases/latest' -Headers @{'User-Agent'='ocp'}).tag_name}catch{try{$req=[System.Net.HttpWebRequest]::Create('https://github.com/microsoft/tgrep/releases/latest');$req.AllowAutoRedirect=$false;$res=$req.GetResponse();$loc=$res.GetResponseHeader('Location');$res.Close();Split-Path $loc -Leaf}catch{'v1.0.5'}};if(-not $tag){$tag='v1.0.5'};$zip=Join-Path $tmp 'tgrep.zip'; Invoke-WebRequest -Uri \"https://github.com/microsoft/tgrep/releases/download/$tag/tgrep-$tag-aarch64-pc-windows-msvc.zip\" -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; $bin=Get-ChildItem -Path $tmp -Recurse -Filter 'tgrep.exe'|Select-Object -First 1; if(-not $bin){throw 'tgrep.exe not found in archive'}; Copy-Item -Path $bin.FullName -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}",
          "darwin-arm64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-aarch64-apple-darwin.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
          "darwin-x64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-x86_64-apple-darwin.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
          "linux-x64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-x86_64-unknown-linux-musl.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\"",
          "linux-arm64": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/microsoft/tgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"v1.0.5\"; curl -fsSL \"https://github.com/microsoft/tgrep/releases/download/${tag}/tgrep-${tag}-aarch64-unknown-linux-musl.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp\" -type f -name tgrep | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/tgrep\""
        }
      }
    },
    "ripgrep": {
      "description": "ripgrep (rg) — fast .gitignore-aware grep; primary backend for the in-agent search tool when present",
      "binary": "rg",
      "url": "https://github.com/BurntSushi/ripgrep/releases",
      "install": {
        "default": "tmp=$(mktemp -d); trap 'rm -rf \"$tmp\"' EXIT; tag=$(curl -sIL -o /dev/null -w '%{url_effective}' https://github.com/BurntSushi/ripgrep/releases/latest | sed 's|.*/tag/||'); [ -z \"$tag\" ] && tag=\"15.2.0\"; arch=$(uname -m); case \"$arch\" in x86_64|amd64) arch=\"x86_64\" ;; aarch64|arm64) arch=\"aarch64\" ;; *) echo \"Unsupported arch: $arch\" >&2; exit 1 ;; esac; os=$(uname -s); case \"$os\" in Darwin*) asset=\"${arch}-apple-darwin\" ;; Linux*) asset=\"${arch}-unknown-linux-musl\" ;; *) echo \"Unsupported OS: $os\" >&2; exit 1 ;; esac; curl -fsSL \"https://github.com/BurntSushi/ripgrep/releases/download/${tag}/ripgrep-${tag}-${asset}.tar.gz\" | tar -xz -C \"$tmp\" && bin=$(find \"$tmp/ripgrep-${tag}-${asset}\" -type f -name rg | head -n 1) && [ -n \"$bin\" ] && mkdir -p \"$HOME/.local/bin\" && chmod +x \"$bin\" && mv \"$bin\" \"$HOME/.local/bin/rg\"",
        "win32-x64": "$cmd=Get-Command rg -ErrorAction SilentlyContinue; $dst=if($cmd){$cmd.Source}else{Join-Path $env:USERPROFILE '.local/bin/rg.exe'}; $dir=Split-Path $dst; if(-not (Test-Path $dir)){New-Item -ItemType Directory -Path $dir -Force|Out-Null}; $tmp=Join-Path $env:TEMP ([Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $tmp -Force|Out-Null; try{$tag=try{(Invoke-RestMethod -Uri 'https://api.github.com/repos/BurntSushi/ripgrep/releases/latest' -Headers @{'User-Agent'='ocp'}).tag_name}catch{try{$req=[System.Net.HttpWebRequest]::Create('https://github.com/BurntSushi/ripgrep/releases/latest');$req.AllowAutoRedirect=$false;$res=$req.GetResponse();$loc=$res.GetResponseHeader('Location');$res.Close();Split-Path $loc -Leaf}catch{'15.2.0'}};if(-not $tag){$tag='15.2.0'};$zip=Join-Path $tmp 'rg.zip'; Invoke-WebRequest -Uri \"https://github.com/BurntSushi/ripgrep/releases/download/$tag/ripgrep-$tag-x86_64-pc-windows-msvc.zip\" -OutFile $zip -UseBasicParsing; Expand-Archive -Path $zip -DestinationPath $tmp -Force; $bin=Get-ChildItem -Path $tmp -Recurse -Filter 'rg.exe'|Select-Object -First 1; if(-not $bin){throw 'rg.exe not found in archive'}; Copy-Item -Path $bin.FullName -Destination $dst -Force} finally{Remove-Item -Path $tmp -Recurse -Force -ErrorAction SilentlyContinue}",
