// Installer-owned switches. Each install applies these values to the target;
// user choices persist here, not under ~/.config/opencode.
{
  "global_commands": true,
  // Opt-in external binaries declared in install/tools.jsonc.
  "tools": {
    // false also removes the bundled OpenRTK plugin from the target.
    "rtk": true,
    "openchamber": true,
    // Implied true when tui_mode is "herdr".
    "herdr": false
  },
  // Unknown default_agent names retain the template value.
  "default_agent": "lite",
  // "herdr" starts a workspace and auto-enables tools.herdr.
  "tui_mode": "direct",
  // Enabled MCPs provision their CLI when the template declares one.
  "mcp": {
    "serena": false,
    // Requires one-time `codegraph init` per repository.
    "codegraph": true,
    // PolyForm Noncommercial: enable only if licensed and indexed.
    "gitnexus": false,
    // Requires a project dbhub.toml and DSN.
    "dbhub": true,
    // Heavy first run downloads the local compression runtime and model.
    "headroom": false,
    // Enable the MCP server in JetBrains before turning this on.
    "idea": false
  },
  // Controls membership in opencode.jsonc's plugin array.
  "plugin": {
    "@dietrichgebert/ponytail": true,
    // Requires supported Node and `qoder login`.
    "opencode-qoder-bridge": false,
    // Persistent-memory capture has an LLM cost per idle session.
    "opencode-mem@2.24.3": false
  }
}
