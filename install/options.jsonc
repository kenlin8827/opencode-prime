// Installer-owned switches. Each install applies these values to the target;
// user choices persist here, not under ~/.config/opencode.
{
  "global_commands": true,
  // Opt-in external binaries declared in install/tools.jsonc.
  "tools": {
    // false also removes the bundled OpenRTK plugin from the target.
    "rtk": true,
    // ripgrep (rg) — fast .gitignore-aware grep. Auto-provisions like rtk/tgrep;
    // uses an existing binary if already on PATH. The in-agent search tool prefers
    // rg when present and falls back to native grep otherwise.
    "ripgrep": true,
    // Optional external full-text index (microsoft/tgrep). Enabled by default:
    // auto-provisions like rtk or uses binary if already on PATH.
    // The tgrep_search tool self-hides until the tgrep CLI is on PATH.
    "tgrep": true,
    // OpenChamber ships as three independent surfaces, one switch each.
    // Web UI CLI (@openchamber/web) — powers `ocp web`. Needs Node.js 22+;
    // disabled by default because it installs a global package.
    "openchamber_web": false,
    // Native desktop app — powers `ocp desktop` / `ocp ui`. Always a
    // separate download (https://openchamber.dev/download); install only
    // checks presence and prints the link when missing.
    "openchamber_desktop": true,
    // VS Code extension (fedaykindev.openchamber) — powers `ocp code`;
    // disabled by default to avoid modifying the user's editor.
    "openchamber_vscode": false,
    // Implied true when tui_mode is "herdr".
    "herdr": false,
    // Implied true when tui_mode is "luvus".
    "luvus": false
  },
  // Unknown default_agent names retain the template value.
  "default_agent": "lite",
  // Direct runs in this shell; herdr and luvus run in a managed workspace.
  "tui_mode": "herdr",
  // Enabled MCPs provision their CLI when the template declares one.
  "mcp": {
    "serena": false,
    // Requires one-time `codegraph init` per repository.
    "codegraph": true,
    // PolyForm Noncommercial: enable only if licensed and indexed.
    "gitnexus": false,
    // Requires a project dbhub.toml and DSN.
    "dbhub": true,
    // Heavy first run downloads the local compression runtime and model.
    "headroom": false,
    // Enable the MCP server in JetBrains before turning this on.
    "idea": false
  },
  // Controls membership in opencode.jsonc's plugin array.
  "plugin": {
    // Requires supported Node and `qoder login`.
    "opencode-qoder-bridge": false,
    // Persistent-memory capture has an LLM cost per idle session.
    "opencode-mem@2.24.3": false
  }
}
