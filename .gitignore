# Dependencies
node_modules/

# Lock files (using bun.lock)
package-lock.json

# Metrics data (generated by metrics plugin)
.metrics/

# Advisor plugin state (legacy runtime file from old installs; current mode
# lives in .ocp/ocp.json's autoAdvisorMode field instead)
.advisor-mode

# ADR iron-law plugin state (project-level switch written by /adr-guard)
.adr-guard

# OS files
Thumbs.db
.DS_Store

# Windows reserved device name (accidental redirect target, e.g. `cmd > nul`)
nul

# Repo snapshot copy (whole tree duplicated, never meant to be tracked)
" 2"/

# Codex CLI runtime output (ephemeral, never meant to be tracked)
.codex/
.omo/

# IDE project files
.idea/

# Release build output (generated by scripts/pack.sh / pack.ps1)
dist/

# Test run log (ephemeral output from local test scripts)
.ocp-test-run.log

# Code review diff artifact (ephemeral, generated during review sessions)
.review.diff

# Ephemeral probe/sync scratch files (never meant to be tracked)
.tmp-*

# uv package cache (ephemeral, created by local tool installs)
.uv-cache/

# Serena per-project state (generated on first MCP server start)
.serena/

# GitNexus per-repo index storage (generated by gitnexus analyze)
.gitnexus/
.codegraph/
.opencode/

# OCP runtime state: ignored wholesale, EXCEPT the team-shared memory file.
# `.ocp/` is mostly per-developer runtime state (ocp.json toggles, logs,
# handoffs, tgrep index), but `.ocp/memory/public.md` is a committed team
# artifact by contract — a lesson filed as public scope is worthless if it
# never reaches the repo. Git cannot re-include a file whose parent
# directory is excluded, so the directory is un-ignored first, then
# narrowed again to the single shared file. `/memory status` probes
# `git check-ignore` and warns if this ever regresses.
.ocp/*
!.ocp/memory/
.ocp/memory/*
!.ocp/memory/public.md

# VitePress documentation build output & cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Working plans (ephemeral design docs — never meant to be tracked)
docs/plan/

# Local Python environments (optional tokenizer benchmark)
.venv/

# Python bytecode caches (ephemeral, generated by any .py import)
**/__pycache__/
*.pyc
.tgrep/

# Test run output (generated by tests/test-all.ps1 — never commit)
test_output.log
tests/test_output.log
