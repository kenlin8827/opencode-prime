# Dependencies
node_modules/

# Lock files (using bun.lock)
package-lock.json

# Metrics data (generated by metrics plugin)
.metrics/

# Advisor plugin state (legacy runtime file from old installs; current mode
# lives in opencode.jsonc's autoAdvisorMode field instead)
.advisor-mode

# ADR iron-law plugin state (project-level switch written by /adr-guard)
.adr-guard

# OS files
Thumbs.db
.DS_Store

# Windows reserved device name (accidental redirect target, e.g. `cmd > nul`)
nul

# Repo snapshot copy (whole tree duplicated, never meant to be tracked)
" 2"/

# Codex CLI runtime output (ephemeral, never meant to be tracked)
.codex/
.omo/

# IDE project files
.idea/

# Release build output (generated by scripts/pack.sh / pack.ps1)
dist/

# Test run log (ephemeral output from local test scripts)
.ocp-test-run.log

# Code review diff artifact (ephemeral, generated during review sessions)
.review.diff

# Ephemeral probe/sync scratch files (never meant to be tracked)
.tmp-*

# uv package cache (ephemeral, created by local tool installs)
.uv-cache/

# Serena per-project state (generated on first MCP server start)
.serena/

# GitNexus per-repo index storage (generated by gitnexus analyze)
.gitnexus/
.codegraph/
.opencode/

# VitePress documentation build output & cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Python bytecode caches (ephemeral, generated by any .py import)
**/__pycache__/
*.pyc
.tgrep/
