{
  "$schema": "../../docs/design/wizard-schema.schema.json",
  "id": "projectGuards",
  "i18nKey": "project.projectGuards.title",
  "description": "On/off project guards (env, E2E, ADR commit law). Project memory is a top-level inline control (project-memory.json); ADR structure (dir + mode) lives in the ADR Settings group (adr.json). Schema-driven; new entries only require a JSON row, no wizard code change. nameKey = localized row display name.",
  "fields": [
    {
