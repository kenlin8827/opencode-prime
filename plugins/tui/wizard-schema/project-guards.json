      "type": "enum",
      "labelKey": "project.switchEnvGuard",
      "descriptionKey": "project.switchEnvGuard",
      "nameKey": "project.nameEnvGuard",
      "badgeKind": "guard",
      "icon": "🔒",
      "values": [
        { "value": "on", "labelKey": "project.valueGuardEnvOn" },
        { "value": "off", "labelKey": "project.valueGuardEnvOff" }
      ],
      "default": "on"
    },
    {
      "key": "e2eGuard",
      "type": "enum",
      "labelKey": "project.switchE2eGuard",
      "descriptionKey": "project.switchE2eGuard",
      "nameKey": "project.nameE2eGuard",
      "badgeKind": "guard",
      "icon": "🧪",
      "values": [
        { "value": "on", "labelKey": "project.valueGuardE2eOn" },
        { "value": "off", "labelKey": "project.valueGuardE2eOff" }
      ],
      "default": "on"
    },
    {
      "key": "adrGuard",
      "type": "enum",
      "labelKey": "project.switchAdrGuard",
      "descriptionKey": "project.switchAdrGuard",
      "nameKey": "project.nameAdrGuard",
      "badgeKind": "guard",
      "icon": "🛡️",
      "values": [
        { "value": "on", "labelKey": "project.valueGuardAdrOn" },
        { "value": "off", "labelKey": "project.valueGuardAdrOff" }
